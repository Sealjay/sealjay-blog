---
interface Props {
  heading?: string
}

const { heading = 'Discussion' } = Astro.props
---

<section class="discussion">
  <h2>{heading}</h2>
  <div class="discussion-actions">
    <button type="button" data-load-discussion hidden>Load discussion</button>
    <a href="https://github.com/Sealjay/sealjay-blog/discussions/categories/comments">Browse discussions on GitHub</a>
  </div>
  <p role="status" class="discussion-status"></p>
  <div class="giscus"></div>
</section>

<style>
  .discussion h2 {
    margin-bottom: 0.75rem;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 650;
    color: var(--color-text);
  }

  .discussion-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .discussion button {
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-sm);
    color: var(--color-primary);
    background: var(--color-surface);
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .discussion a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .discussion-status {
    color: var(--color-text-muted);
  }

  .discussion :global(.giscus-frame) {
    width: 100%;
    border: 0;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-load-discussion]')
  const container = document.querySelector<HTMLElement>('.giscus')
  const status = document.querySelector<HTMLElement>('.discussion-status')

  if (button && container && status) {
    const theme = () => document.documentElement.dataset.theme === 'dark' ? 'dark_dimmed' : 'light'
    button.hidden = false
    button.addEventListener('click', () => {
      if (button.disabled) return
      button.disabled = true
      status.textContent = 'Loading discussion…'
      const script = document.createElement('script')
      script.src = 'https://giscus.app/client.js'
      script.crossOrigin = 'anonymous'
      script.async = true
      Object.assign(script.dataset, {
        repo: 'Sealjay/sealjay-blog',
        repoId: 'R_kgDOIFGusQ',
        category: 'Comments',
        categoryId: 'DIC_kwDOIFGusc4CWbkg',
        mapping: 'pathname',
        strict: '0',
        reactionsEnabled: '1',
        emitMetadata: '0',
        inputPosition: 'bottom',
        theme: theme(),
        lang: 'en',
      })
      script.addEventListener('error', () => {
        script.remove()
        button.disabled = false
        status.textContent = 'Could not load the discussion. Try again or open GitHub.'
      })
      script.addEventListener('load', () => {
        const frame = container.querySelector<HTMLIFrameElement>('.giscus-frame')
        if (!frame) {
          script.remove()
          button.disabled = false
          status.textContent = 'Could not load the discussion. Try again or open GitHub.'
          return
        }
        button.hidden = true
        status.textContent = ''
        const syncTheme = () => frame.contentWindow?.postMessage(
          { giscus: { setConfig: { theme: theme() } } },
          'https://giscus.app',
        )
        frame.addEventListener('load', syncTheme)
        new MutationObserver(syncTheme).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        })
      })
      container.append(script)
    })
  }
</script>
