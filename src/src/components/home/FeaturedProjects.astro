---
import type { CollectionEntry } from 'astro:content'

interface Props {
  projects: CollectionEntry<'project'>[]
}

const { projects } = Astro.props
---

<div class="projects-grid">
  {projects.map(({ data }) => (
    <article class="project-card">
      <h3>{data.title}</h3>
      <p>{data.description}</p>
      {(data.demoUrl || data.repoUrl) && (
        <div class="project-actions">
          {data.demoUrl && (
            <a href={data.demoUrl}>
              {new URL(data.demoUrl).hostname === 'orcid.org' ? 'Research profile' : 'Visit project'}
              <span class="sr-only"> for {data.title}</span>
            </a>
          )}
          {data.repoUrl && <a href={data.repoUrl}>GitHub<span class="sr-only"> for {data.title}</span></a>}
        </div>
      )}
    </article>
  ))}
</div>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    overflow-wrap: anywhere;
  }

  .project-card h3 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .project-card p {
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
  }

  .project-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-weight: 650;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  @media (min-width: 900px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
