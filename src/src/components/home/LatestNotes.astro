---
import type { CollectionEntry } from 'astro:content'

interface Props {
  dayGroups: [string, CollectionEntry<'note'>[]][]
}

const { dayGroups } = Astro.props
const dayFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
})
---

<div class="note-days">
  {dayGroups.map(([dateKey, notes]) => {
    const dayUrl = `/notes/${dateKey}/`
    const summary = notes.find((note) => note.data.daySummary)?.data.daySummary
    const previews = notes.slice(0, 3)
    return (
      <div class="note-day">
        <h3><a href={dayUrl}><time datetime={dateKey}>{dayFormat.format(new Date(dateKey))}</time></a></h3>
        <div class="note-day__content">
          <ul>
            {previews.map(({ id, data }) => (
              <li><a href={`${dayUrl}#${id}`}>{data.description || data.title || 'Read note'}</a></li>
            ))}
          </ul>
          {summary && <p class="note-day__summary">AI summary · {summary}</p>}
          {notes.length > previews.length && <a class="note-day__more" href={dayUrl}>All notes from this day</a>}
        </div>
      </div>
    )
  })}
</div>

<style>
  .note-days {
    border-top: 1px solid var(--color-border-strong);
  }

  .note-day {
    display: grid;
    gap: 0.4rem 1.5rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .note-day h3,
  .note-day__more {
    font-size: 0.9375rem;
    font-family: var(--font-heading);
    font-weight: 650;
  }

  .note-day a {
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 0.16em;
  }

  .note-day a:hover {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }

  .note-day__content {
    min-width: 0;
    max-width: 72ch;
    overflow-wrap: anywhere;
  }

  .note-day__summary {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .note-day ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note-day li + li {
    margin-top: 0.4rem;
  }

  .note-day__more {
    display: inline-block;
    margin-top: 0.4rem;
    color: var(--color-primary);
  }

  @media (min-width: 640px) {
    .note-day {
      grid-template-columns: 7rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
</style>
