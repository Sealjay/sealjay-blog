---
import { Image } from 'astro:assets'
import { SITE_NAV, SITE_SECONDARY_NAV } from '../../consts'
import HeaderLink from './HeaderLink.astro'
import DarkModeToggle from './DarkModeToggle.astro'
import SearchDialog from './SearchDialog.astro'
import avatarSrc from '../../assets/chris/avatar.jpg'
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo-link" aria-label="sealjay home">
      <span class="logo-avatar-ring" aria-hidden="true">
        <Image src={avatarSrc} alt="" class="logo-avatar" width={24} height={24} loading="eager" />
      </span>
      <span class="logo-wordmark">sealjay</span>
    </a>

    <nav aria-label="Main navigation" class="desktop-nav">
      <ul class="nav-list">
        {SITE_NAV.map((item) => (
          <li><HeaderLink href={item.path}>{item.name}</HeaderLink></li>
        ))}
        <li>
          <details class="more-dropdown" data-nav-disclosure>
            <summary class="more-trigger">
              More
              <svg xmlns="http://www.w3.org/2000/svg" class="more-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <ul class="more-panel">
              {SITE_SECONDARY_NAV.map((item) => (
                <li><HeaderLink href={item.path}>{item.name}</HeaderLink></li>
              ))}
            </ul>
          </details>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <SearchDialog />
      <DarkModeToggle />
    </div>

    <details class="mobile-menu" data-nav-disclosure>
      <summary class="mobile-menu-trigger" aria-label="Menu">
        <svg class="menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </summary>
      <nav aria-label="Main navigation" class="mobile-nav">
        <ul>
          {[...SITE_NAV, ...SITE_SECONDARY_NAV].map((item) => (
            <li><HeaderLink href={item.path}>{item.name}</HeaderLink></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 44px;
    align-items: center;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 16px;
    min-height: 60px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    grid-column: 2;
    grid-row: 1;
    align-self: start;
    margin-top: 8px;
  }

  .header-actions :global(mode-toggle:not(:defined)) {
    display: none !important;
  }

  /* Logo */
  .logo-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    justify-self: start;
    margin-top: 15px;
  }

  .logo-avatar-ring {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), #818cf8);
    padding: 2px;
    flex-shrink: 0;
  }

  .logo-avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
  }

  .logo-wordmark {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    color: var(--color-text);
  }

  .logo-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .desktop-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .more-dropdown {
    position: relative;
  }

  .more-trigger,
  .mobile-menu-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .more-trigger::-webkit-details-marker,
  .mobile-menu-trigger::-webkit-details-marker {
    display: none;
  }

  .more-trigger:hover,
  .more-dropdown[open] .more-trigger,
  .mobile-menu-trigger:hover,
  .mobile-menu[open] .mobile-menu-trigger {
    color: var(--color-primary);
    background: var(--color-primary-muted);
  }

  .more-chevron {
    width: 14px;
    height: 14px;
  }

  .more-dropdown[open] .more-chevron {
    transform: rotate(180deg);
  }

  .more-panel {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    min-width: 160px;
    padding: 4px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--color-card-glow), 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .more-panel :global(.header-link),
  .mobile-nav :global(.header-link) {
    display: flex;
  }

  .mobile-menu {
    grid-column: 1 / -1;
    grid-row: 1;
    margin-top: 8px;
    margin-bottom: 8px;
    pointer-events: none;
  }

  .mobile-menu-trigger {
    margin-inline-start: auto;
    width: 44px;
    padding: 0;
    pointer-events: auto;
  }

  .menu-icon-open,
  .menu-icon-close {
    width: 24px;
    height: 24px;
  }

  .menu-icon-close,
  .mobile-menu[open] .menu-icon-open {
    display: none;
  }

  .mobile-menu[open] .menu-icon-close {
    display: block;
  }

  .mobile-nav {
    max-height: 50dvh;
    margin-top: 8px;
    padding: 8px 0 4px;
    overflow-y: auto;
    border-top: 1px solid var(--color-border);
    pointer-events: auto;
  }

  @media (min-width: 768px) {
    .header-inner {
      grid-template-columns: 1fr auto auto;
    }

    .desktop-nav {
      display: flex;
      grid-column: 2;
      grid-row: 1;
    }

    .header-actions {
      grid-column: 3;
    }

    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  const disclosures = document.querySelectorAll<HTMLDetailsElement>('[data-nav-disclosure]')

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || event.defaultPrevented || document.querySelector('dialog[open]')) return
    for (const disclosure of disclosures) {
      if (!disclosure.open || !disclosure.getClientRects().length) continue
      event.preventDefault()
      disclosure.open = false
      disclosure.querySelector('summary')?.focus()
    }
  })

  for (const disclosure of disclosures) {
    disclosure.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !disclosure.contains(event.relatedTarget)) {
        disclosure.open = false
      }
    })

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !disclosure.contains(event.target)) {
        disclosure.open = false
      }
    })
  }

  matchMedia('(min-width: 768px)').addEventListener('change', () => {
    for (const disclosure of disclosures) disclosure.open = false
  })
</script>
