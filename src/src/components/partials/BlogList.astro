---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import FormattedDate from './FormattedDate.astro'
import { getTagStyle } from '../../lib/tag-categories'

interface Props {
  posts: CollectionEntry<'blog'>[]
  allTags: string[]
  /** Tag currently being filtered on; omit for the unfiltered list ("All" active) */
  activeTag?: string
  /** Emit h-feed/h-entry microformat classes (only wanted on the main listing) */
  microformats?: boolean
}

const { posts, allTags, activeTag, microformats = false } = Astro.props
const featuredTopics = ['AI', 'AI Governance', 'Open Source', 'Green Software']
const visibleTopics = [...new Set([...featuredTopics, ...(activeTag ? [activeTag] : [])])]
  .filter((topic) => allTags.includes(topic))
const otherTopics = allTags.filter((topic) => !visibleTopics.includes(topic))
const topicPath = (topic: string) => `/blog/tag/${topic.toLowerCase().replace(/\s+/g, '-')}/`
---

{/* Tag filter bar */}
<nav class="tag-filter-bar" aria-label="Filter by tag">
  <a
    href="/blog"
    class:list={['tag-pill', !activeTag && 'tag-pill--active']}
    aria-current={!activeTag ? 'page' : undefined}
  >
    All
  </a>
  {visibleTopics.map((t) => {
    const isActive = t === activeTag
    return (
      <a
        href={topicPath(t)}
        class:list={['tag-pill', isActive && 'tag-pill--active']}
        aria-current={isActive ? 'page' : undefined}
      >
        {t}
      </a>
    )
  })}
  {otherTopics.length > 0 && (
    <details class="tag-filter-more">
      <summary class="tag-pill">Browse all topics</summary>
      <div class="tag-filter-more__topics">
        {allTags.map((topic) => (
          <a
            class:list={['tag-pill', topic === activeTag && 'tag-pill--active']}
            aria-current={topic === activeTag ? 'page' : undefined}
            href={topicPath(topic)}
          >{topic}</a>
        ))}
      </div>
    </details>
  )}
</nav>

{/* Article list */}
<div class:list={[microformats && 'h-feed', 'blog-list']}>
  {posts.map((post) => {
    const wordCount = post.body ? post.body.split(/\s+/).length : 0
    const readingTime = wordCount > 0 ? Math.max(1, Math.ceil(wordCount / 200)) : undefined
    const excerpt = post.data.description
      ? post.data.description.length > 120
        ? `${post.data.description.slice(0, 120)}...`
        : post.data.description
      : undefined

    return (
      <a
        href={`/blog/${post.id}/`}
        class:list={[microformats && 'h-entry u-url', 'blog-card', post.data.heroImage && 'blog-card--with-image', 'group']}
      >
        {post.data.heroImage ? (
          <div class="blog-card__image">
            <Picture
              src={post.data.heroImage}
              formats={['avif', 'webp']}
              alt=""
              width={800}
              height={450}
              layout="constrained"
              loading="lazy"
              class="blog-card__img"
            />
          </div>
        ) : null}
        <div class="blog-card__body">
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="blog-card__tags">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="blog-card__tag p-category" style={getTagStyle(tag)}>{tag}</span>
              ))}
            </div>
          )}
          <h2 class:list={[microformats && 'p-name', 'blog-card__title', 'font-heading']}>{post.data.title}</h2>
          <div class="blog-card__meta">
            <FormattedDate date={post.data.pubDateTime} class={microformats ? 'dt-published' : undefined} />
            {readingTime && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>{readingTime} min read</span>
              </>
            )}
          </div>
          {excerpt && (
            <p class="blog-card__excerpt">{excerpt}</p>
          )}
        </div>
      </a>
    )
  })}
</div>

{/* Pagination controls */}
<div class="blog-pagination" hidden>
  <p class="blog-pagination__count" role="status">
    Showing <span data-showing>{Math.min(12, posts.length)}</span> of <span>{posts.length}</span> posts
  </p>
  {posts.length > 12 && (
    <button class="blog-pagination__btn" type="button" data-load-more>
      Show more
    </button>
  )}
</div>

<style>
  /* Tag filter bar */
  .tag-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag-filter-more {
    flex-basis: 100%;
  }

  .tag-filter-more summary {
    display: list-item;
    width: fit-content;
    list-style-position: inside;
    cursor: pointer;
  }

  .tag-filter-more__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    padding: 0.5rem 0.875rem;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    transition: background var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .tag-pill:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .tag-pill--active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary, #fff);
  }

  .tag-pill--active:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary, #fff);
  }

  /* Blog list */
  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Blog card */
  .blog-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--color-card-glow);
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
  }

  @media (min-width: 640px) {
    .blog-card--with-image {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
  }

  @media (min-width: 768px) {
    .blog-card--with-image {
      grid-template-columns: 16rem minmax(0, 1fr);
    }
  }

  .blog-card[hidden],
  .blog-pagination[hidden] {
    display: none;
  }

  .blog-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
    box-shadow: var(--color-card-glow), var(--color-card-glow-hover);
  }

  .blog-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .blog-card__image {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  .blog-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .blog-card:hover .blog-card__img {
    transform: scale(1.05);
  }

  .blog-card__body {
    padding: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.5rem;
  }

  .blog-card__tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--tag-bg, var(--color-primary-muted));
    color: var(--tag-color, var(--color-primary));
    border: 1px solid color-mix(in srgb, var(--tag-color, var(--color-primary)) 25%, transparent);
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .blog-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
    margin: 0;
    overflow-wrap: anywhere;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .blog-card:hover .blog-card__title {
    color: var(--color-primary);
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    margin-top: 0.5rem;
  }

  .blog-card__excerpt {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  /* Pagination */
  .blog-pagination {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    padding-bottom: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .blog-pagination__count {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .blog-pagination__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1.5rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .blog-pagination__btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .blog-pagination__btn[hidden] {
    display: none;
  }
</style>

<script>
  function initBlogPagination() {
    const PAGE_SIZE = 12
    const list = document.querySelector<HTMLElement>('.blog-list')
    const btn = document.querySelector<HTMLButtonElement>('[data-load-more]')
    const pagination = document.querySelector<HTMLElement>('.blog-pagination')
    const showing = pagination?.querySelector<HTMLElement>('[data-showing]')

    if (!list || !btn || !pagination || !showing || pagination.dataset.ready) return
    pagination.dataset.ready = 'true'

    const cards = Array.from(list.querySelectorAll<HTMLElement>('.blog-card'))
    let visible = PAGE_SIZE

    btn.addEventListener('click', () => {
      const start = visible
      visible = Math.min(start + PAGE_SIZE, cards.length)
      for (const card of cards.slice(start, visible)) card.hidden = false
      showing.textContent = String(visible)
      cards[start]?.focus()
      btn.hidden = visible >= cards.length
    })

    for (const card of cards.slice(PAGE_SIZE)) card.hidden = true
    pagination.hidden = false
  }

  document.addEventListener('astro:page-load', initBlogPagination)
  initBlogPagination()
</script>
