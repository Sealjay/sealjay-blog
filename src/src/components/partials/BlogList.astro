---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import FormattedDate from './FormattedDate.astro'
import { tagSlug } from '../../lib/tag-categories'

interface Props {
  posts: CollectionEntry<'blog'>[]
  allTags: string[]
  /** Tag currently being filtered on; omit for the unfiltered list ("All" active) */
  activeTag?: string
  /** Emit h-feed/h-entry microformat classes (only wanted on the main listing) */
  microformats?: boolean
}

const { posts, allTags, activeTag, microformats = false } = Astro.props
const featuredTopics = ['AI', 'AI Governance', 'Open Source', 'Green Software']
const visibleTopics = [...new Set([...featuredTopics, ...(activeTag ? [activeTag] : [])])]
  .filter((topic) => allTags.includes(topic))
const otherTopics = allTags.filter((topic) => !visibleTopics.includes(topic))
const topicPath = (topic: string) => `/blog/tag/${tagSlug(topic)}/`
---

{/* Tag filter bar */}
<nav class="tag-filter-bar" aria-label="Filter by tag">
  <a
    href="/blog"
    class:list={['tag-pill', !activeTag && 'tag-pill--active']}
    aria-current={!activeTag ? 'page' : undefined}
  >
    All
  </a>
  {visibleTopics.map((t) => {
    const isActive = t === activeTag
    return (
      <a
        href={topicPath(t)}
        class:list={['tag-pill', isActive && 'tag-pill--active']}
        aria-current={isActive ? 'page' : undefined}
      >
        {t}
      </a>
    )
  })}
  {otherTopics.length > 0 && (
    <details class="tag-filter-more">
      <summary class="tag-pill">Browse all topics</summary>
      <div class="tag-filter-more__topics">
        {allTags.map((topic) => (
          <a
            class:list={['tag-pill', topic === activeTag && 'tag-pill--active']}
            aria-current={topic === activeTag ? 'page' : undefined}
            href={topicPath(topic)}
          >{topic}</a>
        ))}
      </div>
    </details>
  )}
</nav>

{/* Article list */}
<div class:list={[microformats && 'h-feed', 'blog-list']}>
  {posts.map((post) => {
    const wordCount = post.body ? post.body.split(/\s+/).length : 0
    const readingTime = wordCount > 0 ? Math.max(1, Math.ceil(wordCount / 200)) : undefined

    return (
      <article class:list={[microformats && 'h-entry', 'blog-card', post.data.listingThumbnail && 'blog-card--with-image']}>
        <div class="blog-card__body">
          <h2 class:list={[microformats && 'p-name', 'blog-card__title']}>
            <a href={`/blog/${post.id}/`} class:list={[microformats && 'u-url']}>{post.data.title}</a>
          </h2>
          <p class="blog-card__excerpt">{post.data.description}</p>
          <div class="blog-card__meta">
            <FormattedDate date={post.data.pubDateTime} class={microformats ? 'dt-published' : undefined} />
            {readingTime && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>{readingTime} min read</span>
              </>
            )}
            {microformats && post.data.tags?.map((tag) => <span class="p-category" hidden>{tag}</span>)}
          </div>
        </div>
        {post.data.listingThumbnail && (
          <Picture src={post.data.listingThumbnail} formats={['webp']} alt="" width={192}
            layout="constrained" loading="lazy" class="blog-card__img" />
        )}
      </article>
    )
  })}
</div>

{/* Pagination controls */}
<div class="blog-pagination" hidden>
  <p class="blog-pagination__count" role="status">
    Showing <span data-showing>{Math.min(12, posts.length)}</span> of <span>{posts.length}</span> posts
  </p>
  {posts.length > 12 && (
    <button class="blog-pagination__btn" type="button" data-load-more>
      Show more
    </button>
  )}
</div>

<style>
  /* Tag filter bar */
  .tag-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag-filter-more {
    flex-basis: 100%;
  }

  .tag-filter-more summary {
    display: list-item;
    width: fit-content;
    list-style-position: inside;
    cursor: pointer;
  }

  .tag-filter-more__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    padding: 0.5rem 0.875rem;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--color-control-border);
    background: transparent;
    color: var(--color-text-muted);
    transition: background var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .tag-pill:hover {
    border-color: var(--color-primary);
    color: var(--color-text);
  }

  .tag-pill--active {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.16em;
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary, #fff);
  }

  .tag-pill--active:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary, #fff);
  }

  .blog-list {
    max-width: 56rem;
  }

  .blog-card {
    display: flex;
    gap: clamp(0.875rem, 3vw, 2rem);
    justify-content: space-between;
    align-items: start;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .blog-card[hidden],
  .blog-pagination[hidden] {
    display: none;
  }

  .blog-card__body {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .blog-card__title {
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .blog-card__title a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  .blog-card__excerpt {
    max-width: 68ch;
    margin-top: 0.375rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .blog-card--with-image :global(picture) {
    flex: 0 0 clamp(5rem, 16vw, 12rem);
    align-self: center;
  }

  .blog-card__img {
    height: auto;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 31rem) {
    .blog-card--with-image {
      flex-direction: column;
    }

    .blog-card--with-image :global(picture) {
      flex: none;
      align-self: start;
      width: 8rem;
    }
  }

  /* Pagination */
  .blog-pagination {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    padding-bottom: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .blog-pagination__count {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .blog-pagination__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1.5rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-control-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .blog-pagination__btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .blog-pagination__btn[hidden] {
    display: none;
  }
</style>

<script>
  function initBlogPagination() {
    const PAGE_SIZE = 12
    const list = document.querySelector<HTMLElement>('.blog-list')
    const btn = document.querySelector<HTMLButtonElement>('[data-load-more]')
    const pagination = document.querySelector<HTMLElement>('.blog-pagination')
    const showing = pagination?.querySelector<HTMLElement>('[data-showing]')

    if (!list || !btn || !pagination || !showing || pagination.dataset.ready) return
    pagination.dataset.ready = 'true'

    const cards = Array.from(list.querySelectorAll<HTMLElement>('.blog-card'))
    let visible = PAGE_SIZE

    btn.addEventListener('click', () => {
      const start = visible
      visible = Math.min(start + PAGE_SIZE, cards.length)
      for (const card of cards.slice(start, visible)) card.hidden = false
      showing.textContent = String(visible)
      cards[start]?.querySelector('a')?.focus()
      btn.hidden = visible >= cards.length
    })

    for (const card of cards.slice(PAGE_SIZE)) card.hidden = true
    pagination.hidden = false
  }

  document.addEventListener('astro:page-load', initBlogPagination)
  initBlogPagination()
</script>
