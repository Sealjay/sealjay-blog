---
import Layout from '../../layouts/BaseLayout.astro'
import Container from '../../components/containers/Container.astro'
import PageHeader from '../../components/partials/PageHeader.astro'
import Badge from '../../components/partials/Badge.astro'
import FormattedDate from '../../components/partials/FormattedDate.astro'
import { splitAppearances } from '../../lib/appearance'
import { getSpeakingEntries } from '../../lib/speaking'

const { upcoming: upcomingTalks, past: pastTalks } = splitAppearances(await getSpeakingEntries())
const sortedSpeakingSlots = [...upcomingTalks, ...pastTalks]

// Group past talks by year
const pastByYear = pastTalks.reduce(
  (acc, slot) => {
    const year = slot.data.date.getUTCFullYear().toString()
    if (!acc[year]) acc[year] = []
    acc[year].push(slot)
    return acc
  },
  {} as Record<string, typeof pastTalks>,
)
const pastYears = Object.keys(pastByYear).sort((a, b) => Number(b) - Number(a))

const eventTypes = [...new Set(pastTalks.map((s) => s.data.eventType))].sort()

const speakingPageJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Speaking',
  description: 'Conference talks, videos, podcasts, and media mentions on Microsoft AI, open source, and green software',
  url: new URL('/speaking/', Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: sortedSpeakingSlots.length,
    itemListElement: sortedSpeakingSlots.map((slot, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: slot.data.url,
      item: {
        '@type': 'CreativeWork',
        name: slot.data.title,
        description: slot.data.description,
        url: slot.data.url,
        creator: {
          '@type': 'Person',
          name: 'Chris Lloyd-Jones',
          url: 'https://sealjay.com',
        },
        about: [
          { '@type': 'Thing', name: slot.data.eventType },
          { '@type': 'Thing', name: slot.data.event },
        ],
      },
    })),
  },
})
---

<Layout
  title="Speaking"
  description="Talks, workshops, recordings and interviews on AI engineering, open source and green software"
  pubDateTime={new Date('1 March 2023')}
  updatedDate={pastTalks[0]?.data.date}
>
  <script type="application/ld+json" set:html={speakingPageJsonLd} />
  <Container>
    <PageHeader
      title="Speaking"
      subtitle="Talks, workshops, recordings and interviews on AI engineering, open source and green software."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Speaking' },
      ]}
    >
      <a
        href="/speaking/kit/"
        class="speaking-kit-link plausible-event-name=Speaker+Kit+Click plausible-event-source=speaking-top"
      >
        Speaker kit and booking
      </a>
    </PageHeader>

    {upcomingTalks.length > 0 && (
      <section class="speaking-section">
        <h2>Upcoming appearances</h2>
        <div class="speaking-entries">
          {upcomingTalks.map(({ data, actions }) => (
            <div class="speaking-entry speaking-entry--upcoming">
              <h3>{data.title}</h3>
              <div class="speaking-entry__meta">
                <span>{data.event}</span>
                <FormattedDate date={data.date} />
                <Badge label={data.eventType} variant="subtle" />
              </div>
              <div class="speaking-entry__actions">
                {actions.map(({ url, label }) => (
                  <a href={url}>{label}<span class="sr-only"> for {data.title}</span></a>
                ))}
              </div>
              {data.description && (
                <details>
                  <summary>Abstract</summary>
                  <p>{data.description}</p>
                </details>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {pastTalks.length > 0 && (
      <section class="speaking-section" aria-labelledby="past-appearances">
        <h2 id="past-appearances">Past appearances</h2>
        {eventTypes.length > 1 && (
          <div class="speaking-filter" hidden>
            <div class="speaking-filter__buttons" role="group" aria-label="Filter past appearances">
              <button type="button" data-filter="all" aria-pressed="true">All</button>
              {eventTypes.map((type) => (
                <button type="button" data-filter={type} aria-pressed="false">{type}</button>
              ))}
            </div>
            <p role="status" class="speaking-filter__count">{pastTalks.length} appearances</p>
          </div>
        )}
        {pastYears.map((year) => (
          <div class="speaking-year">
            <h3 class="speaking-year__heading">{year}</h3>
            <div class="speaking-entries">
              {pastByYear[year].map(({ data, actions }) => (
                <div class="speaking-entry" data-event-type={data.eventType}>
                  <h4>{data.title}</h4>
                  <div class="speaking-entry__meta">
                    <span>{data.event}</span>
                    <FormattedDate date={data.date} />
                    <Badge label={data.eventType} variant="subtle" />
                  </div>
                  <div class="speaking-entry__actions">
                    {actions.map(({ url, label }) => (
                      <a href={url}>{label}<span class="sr-only"> for {data.title}</span></a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </section>
    )}

    <p class="speaking-footer">
      <a
        href="/speaking/kit/"
        class="plausible-event-name=Speaker+Kit+Click plausible-event-source=speaking-cta"
      >
        Speaker kit and booking
      </a>
    </p>
  </Container>
</Layout>

<style>
  .speaking-kit-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    font-family: var(--font-heading);
    font-weight: 650;
    color: var(--color-on-primary, #fff);
    background: var(--color-primary);
    border-radius: var(--radius-md);
  }

  .speaking-kit-link:hover {
    text-decoration: underline;
  }

  .speaking-section {
    margin-bottom: 3rem;
  }

  h2,
  h3,
  h4 {
    font-family: var(--font-heading);
    font-weight: 650;
    color: var(--color-text);
  }

  h2 {
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
  }

  .speaking-year {
    margin-top: 1.75rem;
  }

  .speaking-year__heading {
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
  }

  .speaking-entry {
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
    overflow-wrap: anywhere;
  }

  .speaking-entry--upcoming {
    padding: 0.875rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .speaking-entry--upcoming + .speaking-entry--upcoming {
    margin-top: 0.75rem;
  }

  .speaking-entry h3,
  .speaking-entry h4 {
    font-size: 1.125rem;
    line-height: 1.35;
  }

  .speaking-entry__meta,
  .speaking-entry__actions,
  .speaking-filter__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.75rem;
  }

  .speaking-entry__meta {
    margin-top: 0.375rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .speaking-entry__actions a,
  .speaking-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .speaking-entry summary {
    cursor: pointer;
    font-weight: 600;
  }

  .speaking-entry details p {
    max-width: 68ch;
    margin-top: 0.5rem;
    color: var(--color-text-muted);
  }

  .speaking-filter__buttons button {
    min-height: 40px;
    padding: 0.375rem 0.875rem;
    background: var(--color-surface);
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .speaking-filter__buttons button:hover {
    text-decoration: underline;
  }

  .speaking-filter__buttons button[aria-pressed='true'] {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary, #fff);
  }

  .speaking-filter__count {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .speaking-footer {
    margin-bottom: 2rem;
  }
</style>

<script>
  function initSpeakingFilters() {
    const filterPanel = document.querySelector<HTMLElement>('.speaking-filter[hidden]')
    const count = filterPanel?.querySelector('[role="status"]')
    if (!filterPanel || !count) return
    const buttons = filterPanel.querySelectorAll<HTMLButtonElement>('button[data-filter]')
    const years = document.querySelectorAll<HTMLElement>('.speaking-year')

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter
        let visibleCount = 0
        for (const year of years) {
          const entries = year.querySelectorAll<HTMLElement>('[data-event-type]')
          let visibleInYear = 0
          for (const entry of entries) {
            entry.hidden = filter !== 'all' && entry.dataset.eventType !== filter
            if (!entry.hidden) visibleInYear += 1
          }
          year.hidden = visibleInYear === 0
          visibleCount += visibleInYear
        }
        for (const other of buttons) other.setAttribute('aria-pressed', String(other === button))
        count.textContent = visibleCount === 1 ? '1 appearance' : `${visibleCount} appearances`
        if (typeof window.plausible !== 'undefined') {
          window.plausible('Speaking Filter', { props: { eventType: filter } })
        }
      })
    }

    filterPanel.hidden = false
  }

  document.addEventListener('astro:page-load', initSpeakingFilters)
  initSpeakingFilters()
</script>
