---
import { Image } from 'astro:assets'
import { getEntry } from 'astro:content'
import Layout from '../../layouts/BaseLayout.astro'
import Container from '../../components/containers/Container.astro'
import PageHeader from '../../components/partials/PageHeader.astro'
import Button from '../../components/partials/Button.astro'
import { globalAiOrganizerAward } from '../../config/personal'
import { speakerBio, topics, talkFormats, logistics, contactCta } from '../../config/speakerKit'
import headshotImage from '../../assets/chris/avatar.jpg'

const selectedAppearances = await Promise.all([
  getEntry('speaking', 'scottish-summit-2026-ai-superhighway'),
  getEntry('speaking', 'yt-9ngj7bauuwo'),
  getEntry('speaking', 'environmental-variables-podcast-2022'),
])
---

<Layout
  title="Speaker Kit"
  description={speakerBio.short}
  pubDateTime={new Date('1 March 2023')}
  updatedDate={new Date('2026-11-27')}
>
  <Container>
    <PageHeader
      title="Chris Lloyd-Jones’s speaker kit"
      subtitle="Talks and workshops on AI engineering, governance and green software."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Speaking', href: '/speaking/' },
        { label: 'Speaker kit' },
      ]}
    >
      <div class="kit-actions">
        <Button href={contactCta.url}>Invite Chris to speak on LinkedIn</Button>
        <Button variant="secondary" href="#bio-and-headshot">Get bio and headshot</Button>
      </div>
    </PageHeader>

    <section class="kit-section" id="bio-and-headshot">
      <h2>Bio and headshot</h2>
      <div class="kit-assets">
        <div>
          <div class="kit-bio">
            <h3>Short bio</h3>
            <p id="bio-short">{speakerBio.short}</p>
            <button type="button" data-copy-target="bio-short" hidden>Copy short bio</button>
            <p role="status" class="kit-copy-status"></p>
          </div>
          <details class="kit-bio kit-bio--long">
            <summary>Long bio</summary>
            <p id="bio-long">{speakerBio.long}{' Global AI Community named him '}<a href={globalAiOrganizerAward.url}>{globalAiOrganizerAward.title}</a>{` for the week of ${globalAiOrganizerAward.weekOf}.`}</p>
            <button type="button" data-copy-target="bio-long" hidden>Copy long bio</button>
            <p role="status" class="kit-copy-status"></p>
          </details>
        </div>
        <figure class="kit-headshot">
          <Image src={headshotImage} alt="Chris Lloyd-Jones" width={160} height={160} layout="fixed" />
          <figcaption>
            <a href={headshotImage.src} download="chris-lloyd-jones-headshot.jpg">Download headshot</a>
            <span>JPEG, {headshotImage.width} × {headshotImage.height} px</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="kit-section">
      <h2>Topics and formats</h2>
      <div class="kit-grid">
        {topics.map((topic) => (
          <div class="kit-topic">
            <h3>{topic.title}</h3>
            <p>{topic.description}</p>
          </div>
        ))}
      </div>
      <h3 class="kit-subheading">Formats</h3>
      <dl class="kit-formats">
        {talkFormats.map((format) => (
          <div>
            <dt>{format.name}</dt>
            <dd>{format.duration}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="kit-section">
      <h2>Selected appearances</h2>
      <div class="kit-grid">
        {selectedAppearances.map((slot) => slot && (
          <div class="kit-appearance">
            <h3>{slot.data.title}</h3>
            <p>{slot.data.event} · {slot.data.eventType}</p>
            <ul class="kit-appearance-links">
              <li><a href={slot.data.url}>{slot.data.cta}</a></li>
              {slot.data.previewUrl && <li><a href={slot.data.previewUrl}>Watch the preview</a></li>}
            </ul>
          </div>
        ))}
      </div>
      <a class="kit-all-talks" href="/speaking/">View all appearances</a>
    </section>

    <section class="kit-section">
      <h2>Practical details</h2>
      <p>When you get in touch, include the event date, audience and format.</p>
      <dl class="kit-logistics">
        {logistics.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  </Container>
</Layout>

<style>
  .kit-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .kit-section {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    scroll-margin-block-start: 5rem;
  }

  h2,
  h3,
  summary,
  dt {
    font-family: var(--font-heading);
    font-weight: 650;
  }

  h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }

  h3,
  summary {
    font-size: 1.0625rem;
  }

  p,
  dd {
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .kit-assets,
  .kit-grid,
  .kit-logistics {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  .kit-bio,
  .kit-appearance {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem;
  }

  .kit-bio p {
    max-width: 68ch;
    margin: 0.5rem 0;
  }

  .kit-bio--long {
    margin-top: 0.75rem;
  }

  .kit-bio summary {
    cursor: pointer;
  }

  .kit-bio button {
    min-height: 44px;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-primary);
  }

  .kit-bio button:hover {
    background: var(--color-primary-muted);
  }

  .kit-bio .kit-copy-status {
    margin: 0;
    font-size: 0.875rem;
  }

  .kit-headshot img {
    border-radius: var(--radius-md);
  }

  .kit-headshot figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .kit-section a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .kit-headshot a,
  .kit-all-talks,
  .kit-appearance a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }

  .kit-topic {
    border-inline-start: 2px solid var(--color-primary);
    padding-inline-start: 0.875rem;
  }

  .kit-subheading {
    margin: 1.5rem 0 0.5rem;
  }

  .kit-formats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .kit-appearance-links {
    margin-top: 0.375rem;
  }

  .kit-all-talks,
  .kit-logistics {
    margin-top: 1rem;
  }

  @media (min-width: 640px) {
    .kit-assets {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2rem;
    }

    .kit-logistics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .kit-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  function initCopyButtons() {
    for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy-target][hidden]')) {
      const bio = document.getElementById(button.dataset.copyTarget ?? '')
      const status = button.parentElement?.querySelector<HTMLElement>('[role="status"]')
      if (!bio || !status) continue

      button.addEventListener('click', async () => {
        status.textContent = ''
        try {
          await navigator.clipboard.writeText(bio.textContent?.trim() ?? '')
          status.textContent = 'Copied to clipboard.'
        } catch {
          status.textContent = 'Couldn’t copy. Select the bio text to copy it.'
        }
      })
      button.hidden = false
    }
  }

  document.addEventListener('astro:page-load', initCopyButtons)
  initCopyButtons()
</script>
