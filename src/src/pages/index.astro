---
import { getCollection } from 'astro:content'
import FeaturedProjects from '../components/home/FeaturedProjects.astro'
import LatestArticle from '../components/home/LatestArticle.astro'
import LatestNotes from '../components/home/LatestNotes.astro'
import Container from '../components/containers/Container.astro'
import Section from '../components/containers/Section.astro'
import { profileRole } from '../config/personal'
import Layout from '../layouts/BaseLayout.astro'
import { groupNotesByDay } from '../lib/notes'

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDateTime.valueOf() - a.data.pubDateTime.valueOf())
  .slice(0, 3)
const projects = (await getCollection('project')).sort((a, b) =>
  Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 3)
const notes = (await getCollection('note'))
  .sort((a, b) => b.data.pubDateTime.valueOf() - a.data.pubDateTime.valueOf())
const recentNoteDays = [...groupNotesByDay(notes)].slice(0, 3)
---

<Layout
  title="Chris Lloyd-Jones, Sealjay"
  description={`Chris Lloyd-Jones (Sealjay) is a Seattle-area ${profileRole} and seven-time Microsoft MVP in AI and Developer Technologies.`}
  pubDateTime={new Date('1 March 2023')}
  updatedDate={new Date('2026-11-27')}
>
  <div class="home-hero">
    <Container>
      <div class="h-card">
        <a href="https://sealjay.com" class="u-url u-uid hidden" aria-hidden="true">Chris Lloyd-Jones</a>
        <a href="https://orcid.org/0000-0001-7995-7865" class="u-url hidden" rel="me" aria-hidden="true">ORCID</a>
        <data class="p-nickname" value="Sealjay" hidden />
        <h1 class="hero-title font-heading p-name">Chris Lloyd-Jones</h1>
        <p class="hero-tagline">Engineering AI that works in the real world</p>
        <p class="hero-intro p-note">
          I'm a Seattle-area <span class="p-job-title">{profileRole}</span>. I work on getting AI into production with clear permissions and accountability. I research Green AI and co-host <a href="https://securing.quest">Securing the Realm</a> with Josh McDonald.
        </p>
      </div>
      <div class="hero-actions">
        <a href="/blog/">Read the writing <span aria-hidden="true">→</span></a>
        <a href="/speaking/">Explore speaking <span aria-hidden="true">→</span></a>
      </div>
    </Container>
  </div>

  {recentPosts.length > 0 && (
    <Section ariaLabel="Recent writing">
      <Container>
        <h2 class="section-title">Recent writing</h2>
        <ul class="writing-list">
          {recentPosts.map((post) => <LatestArticle post={post} />)}
        </ul>
        <a class="archive-link" href="/blog/">All writing <span aria-hidden="true">→</span></a>
      </Container>
    </Section>
  )}

  {projects.length > 0 && (
    <Section bg="alt" ariaLabel="Featured projects">
      <Container>
        <h2 class="section-title">Featured projects</h2>
        <FeaturedProjects projects={projects} />
        <a class="archive-link" href="/projects/">All projects <span aria-hidden="true">→</span></a>
      </Container>
    </Section>
  )}

  {recentNoteDays.length > 0 && (
    <Section ariaLabel="Latest notes">
      <Container>
        <h2 class="section-title">Latest notes</h2>
        <LatestNotes dayGroups={recentNoteDays} />
        <a class="archive-link" href="/notes/">All notes <span aria-hidden="true">→</span></a>
      </Container>
    </Section>
  )}
</Layout>

<style>
  .home-hero {
    padding-block: clamp(2.5rem, 7vw, 5.5rem);
    background: var(--gradient-hero);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-title {
    font-size: clamp(2.25rem, 5.5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 750;
    text-wrap: balance;
  }

  .hero-tagline {
    max-width: 40ch;
    margin-top: 0.8rem;
    font-family: var(--font-body);
    font-size: clamp(1.2rem, 2.4vw, 1.75rem);
    line-height: 1.35;
    color: var(--color-text);
    text-wrap: balance;
  }

  .hero-intro {
    max-width: 58ch;
    margin-top: 1.25rem;
    color: var(--color-text);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.65;
  }

  .hero-intro a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .hero-actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero-actions a {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    background: var(--color-surface);
    font-family: var(--font-heading);
    font-weight: 650;
    font-size: 0.9375rem;
  }

  .hero-actions a:hover {
    background: var(--color-surface-hover);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .writing-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border-strong);
  }

  .archive-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    min-height: 44px;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 374px) {
    .hero-actions a {
      font-size: 0.875rem;
      padding-inline: 0.65rem;
      gap: 0.35rem;
    }
  }
</style>
