---
import Layout from '../../layouts/BaseLayout.astro'
import { groupNotesByDay } from '../../lib/notes'
import Container from '../../components/containers/Container.astro'
import PageHeader from '../../components/partials/PageHeader.astro'
import { getCollection } from 'astro:content'
import FormattedDate from '../../components/partials/FormattedDate.astro'
import { getProjectLinks } from '../../lib/projects'
import { getSpeakingEntries } from '../../lib/speaking'

interface NoteDetail {
  text: string
  time: string
  url: string
  externalUrl?: string
  externalPlatform?: string
}

interface StreamItem {
  type: 'article' | 'talk' | 'podcast' | 'short' | 'note' | 'project'
  title: string
  description?: string
  date: Date
  url?: string
  action?: string
  secondary?: { url: string; label: string }[]
  noteItems?: NoteDetail[]
}

const [blogEntries, speakingEntries, noteEntries, projectEntries] = await Promise.all([
  getCollection('blog'), getSpeakingEntries(), getCollection('note'), getCollection('project'),
])

const blogItems: StreamItem[] = blogEntries.map(({ data, id }) => ({
  type: 'article',
  title: data.title,
  description: data.description,
  date: data.pubDateTime,
  url: `/blog/${id}/`,
  action: 'Read article',
}))

const speakingItems: StreamItem[] = speakingEntries.map(({ data, actions }) => ({
  type: data.eventType === 'Podcast' ? 'podcast' : data.eventType === 'Short' ? 'short' : 'talk',
  title: data.title,
  description: data.event,
  date: data.date,
  url: actions[0].url,
  action: actions[0].label,
  secondary: actions.slice(1),
}))

const noteGroupItems: StreamItem[] = [...groupNotesByDay(noteEntries)].map(([day, notes]) => {
  notes.sort((a, b) => a.data.pubDateTime.valueOf() - b.data.pubDateTime.valueOf())
  return {
    type: 'note',
    title: notes.length === 1 ? 'Note' : 'Notes',
    date: notes[0].data.pubDateTime,
    url: `/notes/${day}/`,
    noteItems: notes.map(({ data, id }) => ({
      text: data.description || 'Note',
      time: data.pubDateTime.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' }),
      url: `/notes/${day}/#${id}`,
      externalUrl: data.externalUrl,
      externalPlatform: data.externalPlatform,
    })),
  }
})

const projectItems: StreamItem[] = projectEntries.map(({ data }) => {
  const [primary, ...secondary] = getProjectLinks(data)
  return {
    type: 'project',
    title: data.title,
    description: primary ? data.description : data.status,
    date: data.date,
    url: primary?.url,
    action: primary?.label,
    secondary,
  }
})

const allItems: StreamItem[] = [...blogItems, ...speakingItems, ...noteGroupItems, ...projectItems].sort(
  (a, b) => b.date.valueOf() - a.date.valueOf(),
)

const groupedItems = allItems.reduce<Record<string, StreamItem[]>>((acc, item) => {
  const key = item.date.toISOString().slice(0, 7)
  const month = acc[key] ??= []
  month.push(item)
  return acc
}, {})

const latestDate = allItems.length > 0 ? allItems[0].date : new Date()

const badgeLabels: Record<StreamItem['type'], string> = {
  article: 'Article',
  talk: 'Speaking',
  podcast: 'Podcast',
  short: 'Short',
  note: 'Note',
  project: 'Project',
}
---

<Layout
  title="Stream"
  description="Everything in one place."
  pubDateTime={new Date('1 March 2023')}
  updatedDate={latestDate}
>
  <Container>
    <PageHeader
      title="Stream"
      subtitle="Writing, speaking, podcasts, shorts, notes and projects in date order."
     
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Stream' },
      ]}
    />

    {/* Filter Pills */}
    <div class="stream-filters" id="stream-filters" role="group" aria-label="Filter stream" hidden>
      <button data-filter="all" class="stream-filter-btn" aria-pressed="true">All</button>
      <button data-filter="article" class="stream-filter-btn" aria-pressed="false">Articles</button>
      <button data-filter="talk" class="stream-filter-btn" aria-pressed="false">Speaking</button>
      <button data-filter="podcast" class="stream-filter-btn" aria-pressed="false">Podcasts</button>
      <button data-filter="short" class="stream-filter-btn" aria-pressed="false">Shorts</button>
      <button data-filter="note" class="stream-filter-btn" aria-pressed="false">Notes</button>
      <button data-filter="project" class="stream-filter-btn" aria-pressed="false">Projects</button>
    </div>

    <p class="stream-count" role="status" hidden></p>

    {/* Stream Items Grouped by Month */}
    {Object.entries(groupedItems).map(([monthYear, items]) => (
      <div class="stream-month" data-month={monthYear}>
        <h2 class="stream-month__heading font-heading">
          <span class="stream-month__bar" />
          {new Date(Number(monthYear.split('-')[0]), Number(monthYear.split('-')[1]) - 1).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}
        </h2>
        <div class="stream-month__items">
          {items.map((item) => (
            <div class="stream-item" data-type={item.type}>
              <div class="stream-meta">
                <span>{item.type === 'note' ? item.title : badgeLabels[item.type]}</span>
                <FormattedDate date={item.date} />
              </div>
              {item.noteItems ? (
                <div class="stream-content">
                  <ul class="stream-notes">
                    {item.noteItems.map((note) => (
                      <li>
                        <a href={note.url} class="stream-note-link">{note.text}</a>
                        <span class="stream-note-time">{note.time} UTC</span>
                        {note.externalUrl && (
                          <a href={note.externalUrl} class="stream-external">
                            {note.externalPlatform ? `Open ${note.externalPlatform} link` : 'Open linked resource'}
                            <span class="sr-only"> from the note at {note.time} UTC</span>
                          </a>
                        )}
                      </li>
                    ))}
                  </ul>
                  {item.noteItems.length > 1 && <a class="stream-action" href={item.url}>All {item.noteItems.length} notes</a>}
                </div>
              ) : (
                <div class="stream-content">
                  {item.url ? (
                    <a href={item.url} class="stream-title">
                      {item.title}{' '}<span class="stream-action">{item.action}</span>
                    </a>
                  ) : <span class="stream-title">{item.title}</span>}
                  {item.description && <p class="stream-description">{item.description}</p>}
                  {item.secondary && item.secondary.length > 0 && (
                    <ul class="stream-secondary">
                      {item.secondary.map((link) => <li><a href={link.url}>{link.label}</a></li>)}
                    </ul>
                  )}
                </div>
              )}
            </div>
          ))}

        </div>
      </div>
    ))}
  </Container>
</Layout>

<script>
  function initStreamFilters() {
    const filters = document.querySelector<HTMLElement>('#stream-filters')
    const status = document.querySelector<HTMLElement>('.stream-count')
    if (!filters || !status || filters.dataset.ready) return
    filters.dataset.ready = 'true'

    const buttons = filters.querySelectorAll<HTMLButtonElement>('.stream-filter-btn')
    const groups = document.querySelectorAll<HTMLElement>('.stream-month')

    function showEntries(filter: string) {
      let count = 0
      for (const group of groups) {
        let visible = 0
        for (const item of group.querySelectorAll<HTMLElement>('.stream-item')) {
          item.hidden = filter !== 'all' && filter !== item.dataset.type
          if (!item.hidden) visible++
        }
        group.hidden = visible === 0
        count += visible
      }
      return count
    }

    function setFilter(filter: string) {
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter))
      }
      const count = showEntries(filter)
      status.textContent = count === 1 ? '1 entry' : `${count} entries`
    }

    for (const button of buttons) {
      button.addEventListener('click', () => setFilter(button.dataset.filter ?? 'all'))
    }
    setFilter('all')
    filters.hidden = false
    status.hidden = false
  }

  // Run on initial load and on Astro page transitions
  document.addEventListener('astro:page-load', initStreamFilters)
  initStreamFilters()
</script>

<style>
  /* Filter pills */
  .stream-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .stream-filters[hidden],
  .stream-item[hidden],
  .stream-month[hidden] {
    display: none;
  }

  .stream-count {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }

  .stream-filter-btn {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-full);
    padding: 0.375rem 1rem;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid var(--color-control-border, var(--color-border-strong));
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .stream-filter-btn:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .stream-filter-btn[aria-pressed="true"] {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    background: var(--color-primary);
    color: var(--color-on-primary, #fff);
    border-color: var(--color-primary);
  }

  .stream-filter-btn[aria-pressed="true"]:hover {
    color: var(--color-on-primary, #fff);
    filter: brightness(1.1);
  }

  /* Month groups */
  .stream-month {
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .stream-month {
      margin-bottom: 3rem;
    }
  }

  .stream-month__heading {
    display: flex;
    align-items: center;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .stream-month__heading {
      font-size: 1.5rem;
    }
  }

  .stream-month__bar {
    display: inline-block;
    width: 4px;
    height: 1.5rem;
    background: var(--color-primary);
    border-radius: var(--radius-full);
    margin-right: 0.75rem;
  }

  .stream-month__items {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .stream-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem 1.25rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
    overflow-wrap: anywhere;
  }

  .stream-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.7rem;
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: 0.9rem;
  }

  .stream-meta > span {
    font-weight: 650;
  }

  .stream-content {
    min-width: 0;
  }

  .stream-title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .stream-content a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .stream-content a:hover {
    text-decoration-thickness: 2px;
  }

  .stream-action,
  .stream-note-time,
  .stream-external {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .stream-title .stream-action {
    display: inline-block;
    margin-inline-start: 0.65rem;
    color: var(--color-text-muted);
  }

  .stream-secondary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 0.25rem;
    font-size: 0.875rem;
  }

  .stream-description {
    margin-top: 0.25rem;
    max-width: 66ch;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .stream-notes {
    display: grid;
    gap: 0.5rem;
    max-width: 66ch;
  }

  .stream-notes + .stream-action {
    display: inline-block;
    margin-top: 0.5rem;
  }

  .stream-note-link {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 1rem;
    line-height: 1.5;
  }

  .stream-note-time,
  .stream-external {
    margin-inline-start: 0.5rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 40rem) {
    .stream-item {
      grid-template-columns: 7.5rem minmax(0, 1fr);
    }

    .stream-meta {
      flex-direction: column;
      align-content: start;
      gap: 0.125rem;
    }
  }
</style>
