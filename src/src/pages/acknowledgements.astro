---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import Container from '../components/containers/Container.astro'
import PageHeader from '../components/partials/PageHeader.astro'
import Layout from '../layouts/BaseLayout.astro'

const credits = (await getCollection('acknowledgement')).sort((a, b) => a.data.title.localeCompare(b.data.title))
const sections = [
  { title: 'Type and visual identity', ids: ['bricolage-grotesque', 'source-serif-4', 'ibm-plex-mono', 'seal-icon', 'x-icon'] },
  { title: 'Pages, search and publishing', ids: ['astro', 'astro-mdx', 'astro-rss', 'astro-sitemap', 'date-fns', 'fuse-js', 'markdown-it', 'open-graph', 'resvg-js', 'satori', 'tailwind', 'tailwind-typography'] },
  { title: 'Discussion and syndication', ids: ['bridgy-fed', 'giscus', 'indieweb', 'webmention-io'] },
  { title: 'Development, hosting and analytics', ids: ['azure-cli', 'azure-swa', 'biome', 'bun', 'claude-code', 'github-actions', 'github-copilot', 'plausible'] },
]
const groups = sections.map(({ title, ids }) => ({ title, entries: credits.filter(({ id }) => ids.includes(id)) }))
const otherCredits = credits.filter(({ id }) => !sections.some(({ ids }) => ids.includes(id)))
if (otherCredits.length) groups.push({ title: 'Other credits', entries: otherCredits })

const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/acknowledgements/*.svg', { eager: true })
---

<Layout
  title="Colophon"
  description="The typefaces, tools and people behind sealjay.com."
  pubDateTime={new Date('2023-05-11')}
  updatedDate={new Date('2026-11-27')}
>
  <Container>
    <PageHeader
      title="Colophon"
      breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Colophon' }]}
    >
      <div class="colophon-intro">
        <p>These are the tools, libraries, knowledge and resources I draw on to build this site. I aim to keep each page’s first download under 250&nbsp;kB, including fonts and images.</p>
        <p><a href="https://github.com/Sealjay/sealjay-blog">View the source on GitHub</a></p>
      </div>
    </PageHeader>

    {groups.map(({ title, entries }) => (
      <section class="credit-group">
        <h2>{title}</h2>
        <ul>
          {entries.map(({ data }) => {
            const logo = data.image && logos[`/src/assets/images/acknowledgements/${data.image}`]?.default
            return (
              <li>
                {logo && <Image src={logo} alt="" width={28} height={28} layout="fixed" loading="lazy" class="credit-logo" />}
                <div>
                  <h3><a href={data.url}>{data.title}</a></h3>
                  <p>{data.description}</p>
                  {data.notes && <p>{data.notes}</p>}
                  <p class="credit-licence">
                    Licence: <a href={data.licenceUrl}>{data.licence}</a>
                    {data.originalUrl && <> · <a href={data.originalUrl}>Previous project link (unavailable)</a></>}
                    {data.archivedUrl && <> · <a href={data.archivedUrl}>Archived {data.title} reference</a></>}
                  </p>
                </div>
              </li>
            )
          })}
        </ul>
      </section>
    ))}
  </Container>
</Layout>

<style>
  section,
  .colophon-intro {
    max-width: 68ch;
  }
  section {
    margin-bottom: 2.25rem;
  }
  h2 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    line-height: 1.3;
  }
  h3 {
    font-size: 1.1875rem;
    font-weight: 650;
    line-height: 1.4;
  }
  p {
    margin-top: 0.375rem;
    font-size: 1.125rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }
  li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
  }
  .credit-logo {
    flex: none;
    margin-top: 0.15rem;
  }
  .credit-licence {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
</style>
